     private HashTable<string, Client> _clients =
         new HashTable<string, Client>(str_hash, str_equal);
 
+    // Since Hyprland 0.56, only numbered workspaces have an "id".
+    // Special and named workspaces are identified by their address,
+    // so we give them stable negative ids to keep the int based API.
+    private HashTable<string, int> _workspace_ids =
+        new HashTable<string, int>(str_hash, str_equal);
+    private int _next_workspace_id = -1000;
+
+    internal int workspace_id(string? address) {
+        if (address == null || address == "") return 0;
+
+        var addr = address.has_prefix("name:") ? address.substring(5) : address;
+
+        int id;
+        if (int.try_parse(addr, out id)) return id;
+
+        if (!_workspace_ids.contains(addr)) {
+            _workspace_ids.insert(addr, _next_workspace_id--);
+        }
+        return _workspace_ids.get(addr);
+    }
+
+    internal int workspace_id_of(Json.Object obj) {
+        if (obj.has_member("address")) {
+            return workspace_id(obj.get_string_member("address"));
+        }
+        return obj.has_member("id") ? (int)obj.get_int_member("id") : 0;
+    }
+
+    // event payloads start with the workspace selector: "<selector>,<name>[,...]"
+    private int workspace_id_of_event(string data) {
+        return workspace_id(data.split(",", 2)[0]);
+    }
+
